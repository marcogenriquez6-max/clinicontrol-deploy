# ============================================================
# CliniControl - imagen de despliegue para Render
# Un único contenedor que sirve el SPA (nginx) y la API (NestJS)
# bajo el mismo origen, para que las cookies de refresco con
# sameSite=strict funcionen sin fricción.
#
# Construcción: docker build -f Dockerfile.render .
# ============================================================

# ---------- Compilación (require herramientas nativas) ----------
FROM node:22-alpine AS builder
RUN apk add --no-cache python3 make gcc g++
WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
RUN npm ci --no-audit --no-fund
COPY backend ./backend
COPY frontend ./frontend
# La API se consume en el mismo origen (baseURL vacío), nginx deriva
# las peticiones de datos hacia el backend según la cabecera Accept.
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL:-}
RUN npm run build

# ---------- Ejecución ----------
FROM node:22-alpine AS runtime
RUN apk add --no-cache nginx tini
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/package.json ./backend/package.json
COPY --from=builder /app/frontend/dist ./frontend/dist
COPY nginx.render.conf /etc/nginx/conf.d/default.conf
COPY nginx.render.conf /etc/nginx/http.d/default.conf
RUN mkdir -p /app/data /app/backups
EXPOSE 80 4000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "-c", "nginx && exec node backend/dist/main.js"]